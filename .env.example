# Vercel automatically provides this when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Google Cloud Console OAuth credentials for a Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Public app URL used for OAuth redirects in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Any long random string. Example: openssl rand -base64 32
APP_SESSION_SECRET=
